{
  "name": "iverblog-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "tsx src/server/dev.ts",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.client.json && tsc -p tsconfig.server.json --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.2.0",
    "es-module-lexer": "^3.0.4",
    "fastify": "^5.6.2",
    "gray-matter": "^4.0.3",
    "parse5": "^8.1.0",
    "postcss": "^8.5.32",
    "postcss-value-parser": "^4.2.0",
    "remark-parse": "^11.0.0",
    "sharp": "^0.34.4",
    "unified": "^11.0.5",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^5.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
